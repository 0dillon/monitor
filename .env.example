# Required: your key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Your timezone (IANA name), used for deadlines and reminder times.
TIMEZONE=UTC

# Your WhatsApp number with country code, digits only (e.g. 2348012345678).
# Used to link the bot with a pairing code, which is easier than scanning a QR from server logs.
PAIRING_NUMBER=

# Leave empty to chat with the bot in your own "Message yourself" chat.
# If you link the bot to a SECOND number, put YOUR number here and chat with it like a contact.
OWNER_NUMBER=

# Optional
# DIGEST_TIMES=09:00,19:00
# REMINDER_DAYS=3
# MODEL=claude-opus-5-5
# DATA_DIR=./data
